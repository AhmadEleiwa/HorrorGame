[node name="Paper" parent="Puzzle1/minipuzzles/2/papers" unique_id=858405693 instance=ExtResource("22_ntbnh")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.17, 1.906, 3.4909477)
title = "dated Spring, 1885"
content = "\"Today I became his wife. The church was full of white roses — he counted them for me, all [color=#771111]4[/color], and said each one was a promise. I have never felt so certain of anything as I did standing beside him.\""

[node name="Paper2" parent="Puzzle1/minipuzzles/2/papers" unique_id=1176401088 instance=ExtResource("22_ntbnh")]
transform = Transform3D(1, 0, 0, 0, 0.9999999, 0, 0, 0, 0.9999999, -0.17, 1.906, 4.456053)
title = "dated Winter, 1887"
content = "\"Our daughter arrived just before dawn, when the house was still and cold. The midwife said she'd never seen a child so quiet. I remember it was the [color=#771111]0[/color] th hour when I first held her — the world outside hadn't even woken yet.\""

[node name="Paper3" parent="Puzzle1/minipuzzles/2/papers" unique_id=367371348 instance=ExtResource("22_ntbnh")]
transform = Transform3D(1, 0, 0, 0, 0.99999994, 0, 0, 0, 0.99999994, -0.17, 1.906, 5.1225967)
title = "dated Spring, 1889"
content = "\"Our daughter counted birds today, the way I once counted roses. She found [color=#771111]2[/color] nesting in the old oak, and laughed so hard she fell into the grass. I wished, foolishly, that this moment could last forever.\""

[node name="Paper5" parent="Puzzle1/minipuzzles/2/papers" unique_id=1361932845 instance=ExtResource("22_ntbnh")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.196095, 1.5032423, 4.432852)
content = "\"He is a good man. Everyone says so. But lately I catch him staring out the window long after the sun has gone, as if waiting for someone who never comes. I do not ask who.\""

