[sub_resource type="GDScript" id="GDScript_umtoh"]
script/source = "@tool
extends StaticBody3D

@onready var books: Node3D = $Books

@export var flip_books:bool = false
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	books.scale.x = 1 if flip_books else -1
"

